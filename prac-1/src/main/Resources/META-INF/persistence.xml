<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                  https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="practical1PU" transaction-type="RESOURCE_LOCAL">

        <provider>com.objectdb.jpa.Provider</provider>

        <class>model.Researcher</class>
        <class>model.Equipment</class>
        <class>model.Booking</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="practical1.odb"/>
        </properties>

    </persistence-unit>

</persistence>